# TraceUX local configuration
# Copy this file to .env and paste a NEW OpenAI key below for live AI findings.
OPENAI_API_KEY=
AI_PROVIDER=openai
MODEL=gpt-4o

# These defaults work with the PostgreSQL container started by npm run traceux.
DATABASE_URL=postgresql://traceux:traceux@localhost:5432/traceux?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:3000
ENABLE_LIVE_BROWSER=false
