generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunStatus {
  QUEUED
  RUNNING
  REVIEW
  COMPLETED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Project {
  id        String    @id @default(cuid())
  name      String
  targetUrl String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  runs      TestRun[]
}

model Persona {
  id            String   @id
  name          String
  description   String
  traits        String[]
  accessibility String?
  patience      Int
  confidence    Int
  createdAt     DateTime @default(now())
}

model TestRun {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal           String
  targetUrl      String
  personaIds     String[]
  status         RunStatus    @default(QUEUED)
  progress       Int          @default(0)
  uxScore        Int?
  completionRate Int?
  frictionCount  Int          @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  events         RunEvent[]
  findings       Finding[]
}

model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  run       TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent     String
  title     String
  detail    String
  progress  Int
  kind      String
  createdAt DateTime @default(now())
}

model Finding {
  id             String          @id @default(cuid())
  runId          String
  run            TestRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  title          String
  summary        String
  severity       FindingSeverity
  confidence     Int
  persona        String
  journeyStep    String
  evidence       Json
  recommendation String
  status         String          @default("Needs review")
  createdAt      DateTime        @default(now())
}
